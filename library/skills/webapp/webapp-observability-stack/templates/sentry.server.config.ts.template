/**
 * sentry.server.config.ts — Sentry server-side instrumentation for {{PROJECT_NAME}}
 * Stack: Next.js 14.2 App Router, @sentry/nextjs 10
 *
 * IMPORTANT: This file must be named exactly `sentry.server.config.ts` (or .js)
 * and placed in the project root.
 *
 * Install: pnpm add @sentry/nextjs
 * Next step: add `instrumentation.ts` to project root (see below).
 *
 * ENV vars required:
 *   SENTRY_DSN            — public-safe, can go in .env.example
 *   SENTRY_AUTH_TOKEN     — SECRET, only in CI/CD secrets (for source maps upload)
 *   NODE_ENV              — set by Next.js automatically
 *   NEXT_PUBLIC_APP_VERSION — semver string from package.json
 *   BUILD_SHA             — git SHA injected in CI
 */

import * as Sentry from '@sentry/nextjs'

const IS_PRODUCTION = process.env.NODE_ENV === 'production'

Sentry.init({
  dsn: process.env.SENTRY_DSN,

  // Disable entirely if DSN not set (e.g. local dev without Sentry)
  enabled: Boolean(process.env.SENTRY_DSN),

  environment: process.env.NODE_ENV ?? 'development',

  release:
    process.env.NEXT_PUBLIC_APP_VERSION ??
    process.env.BUILD_SHA ??
    'dev',

  // ─── Sample rates ─────────────────────────────────────────────────
  // Capture 100% of errors in dev, 100% in prod (low-traffic single-user app)
  // For high-traffic: reduce to 0.1 or use tracesSampler for adaptive sampling
  tracesSampleRate: IS_PRODUCTION ? 0.1 : 1.0,

  // ─── PII filtering ────────────────────────────────────────────────
  beforeSend(event) {
    // Strip request body from events (may contain PII)
    if (event.request?.data) {
      delete event.request.data
    }

    // Strip cookies
    if (event.request?.cookies) {
      delete event.request.cookies
    }

    // Anonymize user IP
    if (event.user?.ip_address) {
      event.user.ip_address = '{{anonymized}}'
    }

    // Strip email from user context
    if (event.user?.email) {
      delete event.user.email
    }

    return event
  },

  // ─── Ignored errors ───────────────────────────────────────────────
  // Don't capture expected errors — reduces noise on free tier
  ignoreErrors: [
    // Browser navigation aborts
    'AbortError',
    'The user aborted a request.',
    // Next.js route not found (handled by app)
    'NEXT_NOT_FOUND',
    // Prisma not found (expected business logic)
    'NotFoundError',
    // Network errors from client that aren't bugs
    'Failed to fetch',
    'NetworkError',
    'Load failed',
  ],

  // ─── Integrations ─────────────────────────────────────────────────
  integrations: [
    // Capture HTTP requests for tracing (server-side)
    Sentry.httpIntegration,
    // Prisma queries tracing (optional — adds latency data)
    // Sentry.prismaIntegration,
  ],
})

