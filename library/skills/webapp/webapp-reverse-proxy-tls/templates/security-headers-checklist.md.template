## 4. Rate limit test

```bash
DOMAIN="{{PROD_DOMAIN}}"

# Test login rate limit (5 prób / 15 min)
echo "--- Login rate limit ---"
for i in $(seq 1 7); do
  STATUS=$(curl -s -o /dev/null -w "%{http_code}" \
    -X POST "https://${DOMAIN}/api/auth/login" \
    -H "Content-Type: application/json" \
    -d '{"email":"test@test.pl","password":"wrongpassword"}')
  echo "Próba $i: HTTP $STATUS"
done
# Oczekiwane: próby 1-5 → 401 (auth fail), próby 6-7 → 429 (rate limited)

# Test X-RateLimit headers
echo "--- Rate limit headers ---"
curl -sI -X POST "https://${DOMAIN}/api/auth/login" \
  -H "Content-Type: application/json" \
  -d '{"email":"x","password":"x"}' | grep -i "x-ratelimit"
# Oczekiwane: X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset
```

