## Restore from B2 (disaster recovery)

Uruchom gdy: VPS utracony / DB corrupted / dane wymagają przywrócenia.

```bash
# Krok 1: Pobierz ostatni backup z B2
rclone ls b2:{{B2_BUCKET_NAME}}/daily/ | sort | tail -3
# Wybierz backup do restore: np. demoapp_2026-05-28_03-00-00.dump.gz

export BACKUP_FILE=demoapp_{{YYYY-MM-DD}}_03-00-00.dump.gz
rclone copy b2:{{B2_BUCKET_NAME}}/daily/${BACKUP_FILE} /tmp/restore/

# Krok 2: Weryfikacja integralności
cat /tmp/restore/${BACKUP_FILE%.gz}.md5
md5sum /tmp/restore/${BACKUP_FILE} | awk '{print $1}'
# Oba muszą być identyczne — jeśli różne: STOP, sprawdź inny backup

# Krok 3: Decompress
gunzip /tmp/restore/${BACKUP_FILE}
export DUMP_FILE=${BACKUP_FILE%.gz}

# Krok 4: Restore do nowej/istniejącej DB
# UWAGA: NISZCZY OBECNĄ BAZĘ — upewnij się, że masz backup bieżącego stanu
docker compose -f compose.prod.yml stop app
docker exec -e PGPASSWORD={{DB_PASSWORD}} {{PROJECT_SLUG}}_db_1 \
  dropdb -U {{DB_USER}} {{DB_NAME}} --if-exists
docker exec -e PGPASSWORD={{DB_PASSWORD}} {{PROJECT_SLUG}}_db_1 \
  createdb -U {{DB_USER}} {{DB_NAME}}
docker exec -i -e PGPASSWORD={{DB_PASSWORD}} {{PROJECT_SLUG}}_db_1 \
  pg_restore -U {{DB_USER}} -d {{DB_NAME}} --no-privileges --no-owner < /tmp/restore/${DUMP_FILE}

# Krok 5: Prisma migrate deploy (schema sync)
docker compose -f compose.prod.yml run --rm app pnpm prisma migrate deploy

# Krok 6: Start app
docker compose -f compose.prod.yml up -d app

# Krok 7: Smoke test restore
curl -sf http://localhost:{{APP_PORT}}/api/ready | jq .
# {"status":"ok","db":"connected"}

# Krok 8: Ręczna weryfikacja danych
# Zaloguj się → sprawdź ostatnie 3-5 ofert w archiwum → czy dane się zgadzają z oczekiwaniami

# Krok 9: Cleanup
rm -rf /tmp/restore/
```

