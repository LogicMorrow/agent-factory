# CI Pipeline — {{PROJECT_NAME}}
# Skill: webapp-ci-cd-workflows v1.0.0 
# Zasada #15 CLAUDE.md pkt 4 — GitHub Actions ci.yml
#
# Podmień zmienne: {{PROJECT_NAME}} {{GHCR_OWNER}} {{APP_PORT}}
#                  {{NODE_VERSION}} {{PNPM_VERSION}} {{COVERAGE_THRESHOLD}}
#
# GitHub-hosted runner (ubuntu-latest). Trivy / deployment → security.yml / cd.yml.

name: CI Pipeline

on:
  push:
    branches: ["**"]
  pull_request:
    branches: [main]

# Anuluj poprzedni run tego samego PR/branch (oszczędność minut Actions)
concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  NODE_VERSION: "{{NODE_VERSION}}"
  PNPM_VERSION: "{{PNPM_VERSION}}"
  IMAGE_NAME: "ghcr.io/{{GHCR_OWNER}}/{{PROJECT_NAME}}"

jobs:
  # ─────────────────────────────────────────────
  # Job 1: Lint
  # ─────────────────────────────────────────────
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "pnpm"

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run ESLint
        run: pnpm lint

  # ─────────────────────────────────────────────
  # Job 2: Typecheck
  # ─────────────────────────────────────────────
  typecheck:
    name: TypeScript Check
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "pnpm"

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: TypeScript strict check
        run: pnpm typecheck

  # ─────────────────────────────────────────────
  # Job 3: Unit + Integration Tests
  # ─────────────────────────────────────────────
  unit-test:
    name: Unit & Integration Tests
    runs-on: ubuntu-latest
    timeout-minutes: 15

    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: testuser
          POSTGRES_PASSWORD: testpassword
          POSTGRES_DB: {{PROJECT_NAME}}_test
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "pnpm"

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run Vitest with coverage
        run: pnpm test:coverage
        env:
          DATABASE_URL: postgresql://testuser:testpassword@localhost:5432/{{PROJECT_NAME}}_test
          NODE_ENV: test

      - name: Coverage gate — minimum {{COVERAGE_THRESHOLD}}%
        run: |
          COVERAGE=$(node -e "
            const summary = require('./coverage/coverage-summary.json');
            console.log(summary.total.lines.pct);
          " 2>/dev/null || echo "0")
          echo "Coverage: $COVERAGE%"
          if (( $(echo "$COVERAGE < {{COVERAGE_THRESHOLD}}" | bc -l) )); then
            echo "Coverage $COVERAGE% < {{COVERAGE_THRESHOLD}}% threshold — FAIL"
            exit 1
          fi
          echo "Coverage $COVERAGE% >= {{COVERAGE_THRESHOLD}}% — PASS"

      - name: Upload coverage report
        if: always
        uses: actions/upload-artifact@v4
        with:
          name: coverage-report
          path: coverage/
          retention-days: 7

  # ─────────────────────────────────────────────
  # Job 4: E2E Tests (Playwright)
  # ─────────────────────────────────────────────
  e2e-test:
    name: E2E Tests (Playwright)
    runs-on: ubuntu-latest
    timeout-minutes: 20
    needs: [lint, typecheck, unit-test]

    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: testuser
          POSTGRES_PASSWORD: testpassword
          POSTGRES_DB: {{PROJECT_NAME}}_e2e
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "pnpm"

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Install Playwright browsers
        run: pnpm exec playwright install --with-deps chromium

      - name: Build application
        run: pnpm build
        env:
          DATABASE_URL: postgresql://testuser:testpassword@localhost:5432/{{PROJECT_NAME}}_e2e
          NODE_ENV: production

      - name: Run database migrations
        run: pnpm prisma migrate deploy
        env:
          DATABASE_URL: postgresql://testuser:testpassword@localhost:5432/{{PROJECT_NAME}}_e2e

      - name: Run Playwright tests
        run: pnpm exec playwright test
        env:
          DATABASE_URL: postgresql://testuser:testpassword@localhost:5432/{{PROJECT_NAME}}_e2e
          BASE_URL: http://localhost:{{APP_PORT}}
          NODE_ENV: test

      - name: Upload Playwright report
        if: always
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: playwright-report/
          retention-days: 7

  # ─────────────────────────────────────────────
  # Job 5: Docker Build (no push)
  # Weryfikuje, że Dockerfile buduje się poprawnie.
  # Push tylko w cd.yml po merge do main.
  # ─────────────────────────────────────────────
  docker-build:
    name: Docker Build (validate only)
    runs-on: ubuntu-latest
    timeout-minutes: 15
    needs: [lint, typecheck]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build Docker image (no push)
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile
          platforms: linux/amd64
          push: false
          tags: ${{ env.IMAGE_NAME }}:pr-${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          build-args: |
            NODE_VERSION=${{ env.NODE_VERSION }}
            PNPM_VERSION=${{ env.PNPM_VERSION }}
