/**
 * Password validators — bcryptjs + zxcvbn
 * single-user-auth-pl v2.0.0
 *
 * Wymagane deps:
 *   pnpm add bcryptjs zxcvbn
 *   pnpm add -D @types/bcryptjs @types/zxcvbn
 *
 * Konfiguracja przez env:
 *   BCRYPT_COST — cost factor, min 12 (default 12)
 *
 * Zasady wg OWASP ASVS §2.1 + §2.4:
 *   - Min 12 znaków (§2.1.1)
 *   - Max 128 znaków (§2.1.2 — zapobiega DoS przez bardzo długie hasła)
 *   - zxcvbn score ≥ 3 z 4 (§2.1.7 breached password check - zxcvbn proxy)
 *   - bcrypt cost ≥ 12 (§2.4.1)
 *   - Blacklist słów kontekstowych (§2.1.8)
 *
 * Placeholders:
 *   {{APP_NAME}}     — np. "demoapp" (trafia do blacklisty)
 *   {{OWNER_NAME}}   — np. "jankowalski" (trafia do blacklisty)
 */

import bcrypt from "bcryptjs";
import zxcvbn from "zxcvbn";

// ─── Konfiguracja ────────────────────────────────────────────────────────

const BCRYPT_COST = Math.max(parseInt(process.env.BCRYPT_COST ?? "12", 10), 12);

/**
 * Blacklista słów PL kontekstowych.
 * zxcvbn przyjmuje user_inputs jako dodatkowy słownik — obniża score.
 * Dodaj tu dane kontekstowe projektu.
 */
const PL_BLACKLIST: string[] = [
  // Słowa generyczne PL
  "haslo",
  "hasło",
  "hasla",
  "hasła",
  "admin",
  "administrator",
  "qwerty",
  "zxcvbn",
  "polska",
  "password",
  "passw0rd",
  // Kontekstowe — dostosuj do projektu
  "{{APP_NAME}}",
  "{{OWNER_NAME}}",
  "demoapp",
  "jankowalski",
  "jankowalski",
  "dekarz",
  "dach",
  "dachy",
  // Wzorce daty
  "2024",
  "2025",
  "2026",
];

// ─── Typy ────────────────────────────────────────────────────────────────

export interface PasswordValidationResult {
  valid: boolean;
  score: number; // 0-4 (zxcvbn)
  feedback: string;
  suggestions: string[];
}

// ─── Walidacja siły hasła ────────────────────────────────────────────────

/**
 * Sprawdza siłę hasła przez zxcvbn + reguły minimalne.
 *
 * Zwraca { valid: true } tylko gdy:
 *   - Długość ≥ 12 i ≤ 128 znaków
 *   - zxcvbn score ≥ 3 (z uwzględnieniem PL_BLACKLIST)
 *
 * @param password     — hasło do sprawdzenia (plaintext, NIE hash)
 * @param extraContext — dodatkowe słowa do blacklisty (np. email użytkownika)
 */
export function validatePasswordStrength(
  password: string,
  extraContext: string[] = []
): PasswordValidationResult {
  // Reguła 1: Minimalna długość
  if (password.length < 12) {
    return {
      valid: false,
      score: 0,
      feedback: "Hasło musi mieć minimum 12 znaków.",
      suggestions: ["Dodaj więcej znaków, np. frazes zamiast słowa."],
    };
  }

  // Reguła 2: Maksymalna długość (DoS prevention)
  if (password.length > 128) {
    return {
      valid: false,
      score: 0,
      feedback: "Hasło nie może przekraczać 128 znaków.",
      suggestions: ["Skróć hasło do maksymalnie 128 znaków."],
    };
  }

  // Reguła 3: zxcvbn z kontekstem PL
  const userInputs = [...PL_BLACKLIST, ...extraContext];
  const result = zxcvbn(password, userInputs);

  if (result.score < 3) {
    const suggestions = [
      ...(result.feedback.suggestions ?? []),
      result.feedback.warning ? result.feedback.warning : "",
    ].filter(Boolean);

    // Polskie sugestie fallback gdy zxcvbn nie daje po PL
    const plSuggestions =
      suggestions.length > 0
        ? suggestions
        : [
            "Użyj kombinacji dużych i małych liter, cyfr oraz znaków specjalnych.",
            "Unikaj słów słownikowych i danych osobowych.",
            "Spróbuj frazy złożonej z kilku losowych słów.",
          ];

    return {
      valid: false,
      score: result.score,
      feedback: `Hasło jest za słabe (wynik: ${result.score}/4, wymagany: 3/4).`,
      suggestions: plSuggestions,
    };
  }

  return {
    valid: true,
    score: result.score,
    feedback: "Hasło jest wystarczająco silne.",
    suggestions: [],
  };
}

// ─── Hashowanie hasła ────────────────────────────────────────────────────

/**
 * Haszuje hasło bcryptjs z cost ≥ 12.
 * Zawsze używaj tej funkcji — nigdy bcrypt.hash bezpośrednio (by cost był enforced).
 *
 * @throws Error jeśli hasło nie spełnia wymagań siły
 */
export async function hashPassword(
  password: string,
  skipStrengthCheck = false
): Promise<string> {
  if (!skipStrengthCheck) {
    const validation = validatePasswordStrength(password);
    if (!validation.valid) {
      throw new Error(`Hasło nie spełnia wymagań bezpieczeństwa: ${validation.feedback}`);
    }
  }

  return bcrypt.hash(password, BCRYPT_COST);
}

/**
 * Porównuje hasło z hashem.
 * Używaj w loginAction — bcrypt.compare jest timing-safe.
 */
export async function verifyPassword(
  password: string,
  hash: string
): Promise<boolean> {
  return bcrypt.compare(password, hash);
}

// ─── CLI seed / reset script ─────────────────────────────────────────────

/**
 * Generuj hash dla scripts/seed-admin.ts i scripts/reset-password.ts.
 * Użycie:
 *   const hash = await generateHashForScript("MojeNowe!Haslo2026");
 *   console.log("OWNER_PASSWORD_HASH=" + hash);
 */
export async function generateHashForScript(plainPassword: string): Promise<string> {
  const validation = validatePasswordStrength(plainPassword);
  if (!validation.valid) {
    throw new Error(
      `Hasło zbyt słabe: ${validation.feedback}\n` +
        `Sugestie: ${validation.suggestions.join(" ")}`
    );
  }
  return bcrypt.hash(plainPassword, BCRYPT_COST);
}
