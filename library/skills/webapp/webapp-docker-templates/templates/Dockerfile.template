# {{PROJECT_NAME}} — multi-stage Dockerfile (audit-ready 18/18, zasada #15 pkt 1)
# Generated by skill webapp-docker-templates v1.0.0
# Stack: Node {{NODE_VERSION}} alpine + pnpm {{PNPM_VERSION}} + Next.js 14.2 LTS standalone output
#
# Wymagane w next.config.js:
#   output: 'standalone'
#
# Build args (opcjonalne, dla image labeling):
ARG BUILD_DATE
ARG GIT_SHA
ARG VERSION

# ─────────────────────────────────────────────────────────────
# Stage 1: deps — instalacja zależności (cached layer)
# ─────────────────────────────────────────────────────────────
FROM node:{{NODE_VERSION}}-alpine AS deps

WORKDIR /app

# Instalacja corepack + pnpm (kolejność: enable PRZED prepare)
RUN corepack enable && corepack prepare pnpm@{{PNPM_VERSION}} --activate

# Kopiuj manifesty pakietów (cache layer — przebudowa tylko przy zmianie)
COPY package.json pnpm-lock.yaml ./

# Kopiuj prisma schema do generowania typów przy install
COPY prisma ./prisma

# Instalacja tylko production deps + devdeps potrzebnych do buildu
# --frozen-lockfile zapobiega cichej aktualizacji lockfile w CI
RUN pnpm install --frozen-lockfile

# ─────────────────────────────────────────────────────────────
# Stage 2: builder — kompilacja TypeScript + Next.js build
# ─────────────────────────────────────────────────────────────
FROM node:{{NODE_VERSION}}-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@{{PNPM_VERSION}} --activate

# Skopiuj node_modules z deps stage (cache-friendly)
COPY --from=deps /app/node_modules ./node_modules

# Skopiuj cały kod źródłowy
COPY . .

# Zmienne środowiskowe dla buildu (Next.js wymaga NEXT_PUBLIC_* w build time)
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Generuj Prisma client (musi być przed build — typy w Route Handlers)
RUN pnpm prisma generate

# Next.js build → .next/standalone (wymaga output: 'standalone' w next.config.js)
RUN pnpm build

# ─────────────────────────────────────────────────────────────
# Stage 3: runner — minimal production image
# ─────────────────────────────────────────────────────────────
FROM node:{{NODE_VERSION}}-alpine AS runner

WORKDIR /app

# Metadane obrazu (OCI labels, przydatne przy audycie SBOM)
LABEL org.opencontainers.image.title="{{PROJECT_NAME}}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.version="${VERSION}"

# Zmienne środowiskowe runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# PORT dziedziczone z compose env lub override
ENV PORT={{APP_PORT}}
ENV HOSTNAME=0.0.0.0

# Utwórz nieprivileged user (UID 1001 nextjs) — zasada #15 security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Skopiuj public assets
COPY --from=builder /app/public ./public

# Skopiuj standalone server (Next.js output: 'standalone')
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./

# Skopiuj statyczne assety (.next/static)
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Skopiuj prisma schema + migrations (potrzebne dla prisma migrate deploy w entrypoint)
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

# Skopiuj entrypoint (musi być przed USER nextjs — chmod wymaga root)
COPY --chown=nextjs:nodejs entrypoint.sh ./
RUN chmod +x ./entrypoint.sh

# Przełącz na nieprivileged user
USER nextjs

# Ekspozycja portu (tylko dokumentacyjna — compose mapuje)
EXPOSE {{APP_PORT}}

# Healthcheck: wget dostępny w alpine bez dodatkowych pakietów
# --start-period=30s = daj czas na prisma migrate + Next.js init
# --interval=30s     = sprawdzaj co 30s po start-period
# --timeout=5s       = timeout pojedynczego sprawdzenia
# --retries=3        = 3 nieudane = unhealthy
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider \
      http://localhost:{{APP_PORT}}/api/health || exit 1

# entrypoint uruchamia: DB wait → prisma migrate → exec CMD
ENTRYPOINT ["./entrypoint.sh"]

# Domyślna komenda (Next.js standalone server)
CMD ["node", "server.js"]
