# {{PROJECT_NAME}} — Docker Compose prod override (zasada #15 pkt 2)
# Generated by skill webapp-docker-templates v1.0.0
#
# Użycie (VPS prod):
#   docker compose -f compose.yml -f compose.prod.yml up -d
#
# Ten plik TYLKO nadpisuje/rozszerza compose.yml — nie jest standalone.
# Prod-specific: resource limits, restart always, env_file .env.production,
#                healthcheck depends_on, logging json-file, brak src mount.
#
# Przed wdrożeniem:
#   1. Utwórz .env.production z DB_PASSWORD, SECRET_COOKIE_PASSWORD, SENTRY_DSN etc.
#   2. Upewnij się że Caddyfile ma {{DOMAIN}} (TLS auto-provisioning)
#   3. Zweryfikuj ghcr.io image tag (GIT_SHA z CD workflow)

name: {{PROJECT_NAME}}

services:
  # ─── app: prod override ───────────────────────────────────────
  app:
    # Prod używa pre-built image z ghcr.io (nie buduje lokalnie)
    image: {{IMAGE_REGISTRY}}:${GIT_SHA:-latest}
    build:
      # Wyłącz build context w prod — używaj tylko gotowego image
      context: .
      dockerfile: Dockerfile
    env_file:
      - .env.production
    environment:
      NODE_ENV: production
      DATABASE_URL: "postgresql://{{DB_USER}}:${DB_PASSWORD}@db:{{DB_PORT}}/{{DB_NAME}}?schema=public"
      PORT: "{{APP_PORT}}"
    # Usuń port mapping w prod (Caddy jest gatewayem, nie expose app bezpośrednio)
    ports: []
    volumes:
      # Usuń dev src mount
      - type: tmpfs
        target: /tmp
    depends_on:
      db:
        condition: service_healthy
    restart: always
    deploy:
      resources:
        limits:
          memory: {{APP_MEM_LIMIT}}
          cpus: '1.0'
        reservations:
          memory: 128m
          cpus: '0.25'
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
        labels: "service={{PROJECT_NAME}}-app,env=production"
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:{{APP_PORT}}/api/ready || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 45s

  # ─── db: prod override ────────────────────────────────────────
  db:
    env_file:
      - .env.production
    restart: always
    deploy:
      resources:
        limits:
          memory: {{DB_MEM_LIMIT}}
          cpus: '0.5'
        reservations:
          memory: 64m
          cpus: '0.1'
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # Prod: dodatkowe postgresql.conf tuning (opcjonalne)
    command: >
      postgres
        -c max_connections=20
        -c shared_buffers=64MB
        -c effective_cache_size=128MB
        -c maintenance_work_mem=32MB
        -c checkpoint_completion_target=0.9
        -c wal_buffers=8MB
        -c default_statistics_target=100

  # ─── proxy: Caddy prod (auto-TLS) ─────────────────────────────
  proxy:
    env_file:
      - .env.production
    restart: always
    deploy:
      resources:
        limits:
          memory: {{PROXY_MEM_LIMIT}}
          cpus: '0.25'
        reservations:
          memory: 16m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # ─── backup: prod override ────────────────────────────────────
  backup:
    env_file:
      - .env.production
    restart: always
    deploy:
      resources:
        limits:
          memory: 64m
          cpus: '0.1'
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "2"
    # Prod: 7 daily + 4 weekly + 12 monthly retention rotation (skill webapp-backup-dr handluje weekly/monthly cykle)
    environment:
      BACKUP_SCHEDULE: "{{BACKUP_SCHEDULE}}"
      BACKUP_RETENTION_DAYS: "{{BACKUP_RETENTION_DAYS}}"
