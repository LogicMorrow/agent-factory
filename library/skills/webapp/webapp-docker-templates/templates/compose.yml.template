# {{PROJECT_NAME}} — Docker Compose dev (zasada #15 pkt 2)
# Generated by skill webapp-docker-templates v1.0.0
# Użycie: docker compose up -d
# 4 services: app + db + proxy + backup
#
# Przed uruchomieniem:
#   1. Skopiuj .env.example → .env.local i uzupełnij zmienne
#   2. Upewnij się że next.config.js ma output: 'standalone'

name: {{PROJECT_NAME}}

services:
  # ─── app: Next.js + Hono (Node 22, pnpm 10) ───────────────────
  app:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        BUILD_DATE: "${BUILD_DATE:-unknown}"
        GIT_SHA: "${GIT_SHA:-dev}"
        VERSION: "${VERSION:-0.0.0-dev}"
    image: {{IMAGE_REGISTRY}}:dev
    container_name: {{PROJECT_NAME}}-app
    env_file:
      - .env.local
    environment:
      DATABASE_URL: "postgresql://{{DB_USER}}:${DB_PASSWORD}@db:{{DB_PORT}}/{{DB_NAME}}?schema=public"
      NODE_ENV: development
      PORT: "{{APP_PORT}}"
    ports:
      - "{{APP_PORT}}:{{APP_PORT}}"
    depends_on:
      db:
        condition: service_healthy
    networks:
      - app-net
    restart: unless-stopped
    volumes:
      # Dev: mount src dla HMR (opcjonalne — usuń w prod)
      - ./src:/app/src:ro

  # ─── db: PostgreSQL 16 alpine ─────────────────────────────────
  db:
    image: postgres:16-alpine
    container_name: {{PROJECT_NAME}}-db
    environment:
      POSTGRES_DB: "{{DB_NAME}}"
      POSTGRES_USER: "{{DB_USER}}"
      POSTGRES_PASSWORD: "${DB_PASSWORD}"
      # Performance tuning dla małego VPS (single-user)
      POSTGRES_INITDB_ARGS: "--encoding=UTF8 --locale=pl_PL.UTF-8"
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks:
      - app-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{DB_USER}} -d {{DB_NAME}}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    restart: unless-stopped

  # ─── proxy: Caddy v2 + auto-TLS Let's Encrypt ─────────────────
  # Dev: HTTP tylko (TLS wymaga publicznej domeny)
  # Prod: auto-TLS przez ACME Let's Encrypt (jeśli DOMAIN ustawiony)
  proxy:
    image: caddy:2-alpine
    container_name: {{PROJECT_NAME}}-proxy
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"   # HTTP/3 QUIC
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    networks:
      - app-net
    depends_on:
      - app
    restart: unless-stopped
    # Caddyfile minimalny (utwórz w katalogu projektu):
    # {{DOMAIN}} {
    #   reverse_proxy app:{{APP_PORT}}
    # }

  # ─── backup: PostgreSQL backup sidecar ────────────────────────
  # Uruchamia pg_dump według harmonogramu (cron wewnątrz kontenera)
  # Przechowuje lokalne backupy w volume backups/
  backup:
    image: postgres:16-alpine
    container_name: {{PROJECT_NAME}}-backup
    environment:
      PGHOST: "db"
      PGPORT: "{{DB_PORT}}"
      PGDATABASE: "{{DB_NAME}}"
      PGUSER: "{{DB_USER}}"
      PGPASSWORD: "${DB_PASSWORD}"
      BACKUP_SCHEDULE: "{{BACKUP_SCHEDULE}}"
      BACKUP_RETENTION_DAYS: "{{BACKUP_RETENTION_DAYS}}"
    volumes:
      - backups:/backups
    networks:
      - app-net
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    # Cron wewnątrz kontenera — pg_dump z rotacją
    command: >
      sh -c "
        echo '${BACKUP_SCHEDULE} pg_dump -Fc -f /backups/backup_$$(date +%Y%m%d_%H%M%S).dump && find /backups -name \"*.dump\" -mtime +${BACKUP_RETENTION_DAYS} -delete' | crontab - &&
        crond -f -l 2
      "

# ─── Volumes ────────────────────────────────────────────────────
volumes:
  pgdata:
    driver: local
  caddy_data:
    driver: local
  caddy_config:
    driver: local
  backups:
    driver: local

# ─── Networks ───────────────────────────────────────────────────
networks:
  app-net:
    driver: bridge
