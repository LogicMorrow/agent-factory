#!/bin/sh
# {{PROJECT_NAME}} entrypoint — audit-ready zasada #15 pkt 2
# Generated by skill webapp-docker-templates v1.0.0
#
# Kolejność: DB wait → prisma migrate deploy → exec server
# Uruchamiany jako nieprivileged user nextjs (UID 1001)
#
# Zmienne środowiskowe (z compose env_file lub environment):
#   DB_HOST      — hostname bazy (default: db)
#   DB_PORT      — port bazy (default: 5432)
#   PORT         — port Next.js (default: {{APP_PORT}})
#   DATABASE_URL — pełne DSN (wymagane przez Prisma)

set -e

DB_HOST="${DB_HOST:-{{DB_HOST}}}"
DB_PORT="${DB_PORT:-{{DB_PORT}}}"
APP_PORT="${PORT:-{{APP_PORT}}}"

# ─────────────────────────────────────────────────────────────
# Step 1: Czekaj na dostępność bazy danych
# nc (netcat) dostępny w alpine bez dodatkowych pakietów
# ─────────────────────────────────────────────────────────────
echo "[entrypoint] Waiting for database at ${DB_HOST}:${DB_PORT}..."

MAX_RETRIES=30
RETRY=0
until nc -z "${DB_HOST}" "${DB_PORT}"; do
  RETRY=$((RETRY + 1))
  if [ "${RETRY}" -ge "${MAX_RETRIES}" ]; then
    echo "[entrypoint] ERROR: Database not available after ${MAX_RETRIES} seconds. Aborting."
    exit 1
  fi
  echo "[entrypoint] DB not yet ready (attempt ${RETRY}/${MAX_RETRIES}), sleeping 1s..."
  sleep 1
done

echo "[entrypoint] Database ready at ${DB_HOST}:${DB_PORT}."

# ─────────────────────────────────────────────────────────────
# Step 2: Prisma migrate deploy
# Idempotentne — bezpieczne przy każdym starcie kontenera
# Nie generuje nowych migracji — tylko aplikuje oczekujące
# ─────────────────────────────────────────────────────────────
echo "[entrypoint] Running Prisma migrations (prisma migrate deploy)..."

if ! pnpm prisma migrate deploy; then
  echo "[entrypoint] ERROR: Prisma migration failed. Check DATABASE_URL and migration files."
  exit 1
fi

echo "[entrypoint] Migrations applied successfully."

# ─────────────────────────────────────────────────────────────
# Step 3: Weryfikacja healthcheck endpoint po starcie
# (opcjonalne w entrypoint — healthcheck w Dockerfile jest primary)
# ─────────────────────────────────────────────────────────────
echo "[entrypoint] Starting Next.js server on port ${APP_PORT}..."
echo "[entrypoint] Build info: GIT_SHA=${GIT_SHA:-unknown}, VERSION=${VERSION:-unknown}"

# exec zastępuje shell procesem serwera (prawidłowe przekazywanie sygnałów SIGTERM)
# "$@" = CMD z Dockerfile ("node" "server.js")
exec "$@"
